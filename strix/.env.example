# Strix configuration — copy to a real local env before running scans.
# NEVER commit real keys. Reference this file from .gitignore.
#
# LLM provider (LiteLLM format). Examples:
#   STRIX_LLM=openai/gpt-5.4
#   STRIX_LLM=anthropic/claude-sonnet-4-6
#   STRIX_LLM=vertex_ai/gemini-3-pro-preview   (Google ADC auth, no key)
#   STRIX_LLM=strix/gpt-5            (models.strix.ai, key = SK_STRIX_...)
#   STRIX_LLM=ollama/llama3.3        (local, no key, needs LLM_API_BASE)
STRIX_LLM=
LLM_API_KEY=

# Optional
# LLM_API_BASE=             # custom OpenAI-compatible / Ollama base URL
# PERPLEXITY_API_KEY=       # web-search capability
# STRIX_REASONING_EFFORT=low|medium|high

# Target of a default scan (local code dirs shown; swap in your deployed URLs)
STRIX_TARGET_FRONTEND=./frontend
STRIX_TARGET_BACKEND=./Backend
STRIX_TARGET_API=https://api.amplivo.in
STRIX_TARGET_WEB=https://www.amplivo.in